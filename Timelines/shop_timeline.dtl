join Daniel left
if {open_shop} == true:
	jump Close
Daniel: Hello Dreamy, would you like to see my inventory?
- Yes, please
	Daniel: All right, I hope you like something
	set {open_shop} = true
- No, maybe next time
	Well, take care of yourself
	set {open_shop} = false
[end_timeline]
label Close
join Daniel left
Daniel: See you next time Dreamy!
set {open_shop} = false
[end_timeline]